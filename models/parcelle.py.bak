from odoo import models, fields, api
from odoo.exceptions import ValidationError

class Parcelle(models.Model):
    _name = 'parcelle.agri'
    _description = 'Parcelle Agricole'
    _rec_name = 'nom'

    nom = fields.Char(string="Nom de la parcelle", required=True)
    exploitation_id = fields.Many2one('exploitation.agri', string="Exploitation", required=True)
    
    # Données géométriques (PostGIS)
    superficie = fields.Float(string="Superficie (ha)", required=True)
    perimetre = fields.Float(string="Périmètre (m)", compute='_compute_perimetre')
    
    # Coordonnées géographiques
    latitude_centre = fields.Float(string="Latitude centre")
    longitude_centre = fields.Float(string="Longitude centre")
    
    # Données pédologiques
    type_sol = fields.Selection([
        ('argileux', 'Argileux'),
        ('limoneux', 'Limoneux'),
        ('sableux', 'Sableux'),
        ('calcaire', 'Calcaire'),
        ('humifere', 'Humifère'),
    ], string="Type de sol")
    
    ph_sol = fields.Float(string="pH du sol")
    capacite_retention = fields.Float(string="Capacité de rétention (mm)")
    
    # Données d'irrigation
    systeme_irrigation = fields.Selection([
        ('gravitaire', 'Gravitaire'),
        ('aspersion', 'Aspersion'),
        ('goutte_goutte', 'Goutte à goutte'),
        ('pivot', 'Pivot'),
        ('aucun', 'Aucun'),
    ], string="Système d'irrigation", default='aucun')
    
    # Relations
    cultures_ids = fields.One2many('culture.agri', 'parcelle_id', string="Cultures")
    interventions_ids = fields.One2many('intervention.agri', 'parcelle_id', string="Interventions")
    
    # Calculs automatiques
    nombre_cultures = fields.Integer(string="Nombre de cultures", compute='_compute_stats')
    rendement_moyen = fields.Float(string="Rendement moyen (t/ha)", compute='_compute_stats')
    
    @api.depends('cultures_ids')
    def _compute_stats(self):
        for record in self:
            record.nombre_cultures = len(record.cultures_ids)
            if record.cultures_ids:
                rendements = record.cultures_ids.mapped('rendement')
                record.rendement_moyen = sum(rendements) / len(rendements) if rendements else 0.0
            else:
                record.rendement_moyen = 0.0
    
    @api.depends('superficie')
    def _compute_perimetre(self):
        for record in self:
            # Approximation du périmètre basée sur la superficie (carré parfait)
            if record.superficie > 0:
                cote = (record.superficie * 10000) ** 0.5  # Conversion ha en m²
                record.perimetre = cote * 4
            else:
                record.perimetre = 0.0
    
    @api.constrains('superficie')
    def _check_superficie(self):
        for record in self:
            if record.superficie <= 0:
                raise ValidationError("La superficie doit être strictement positive.")
    
    @api.constrains('ph_sol')
    def _check_ph(self):
        for record in self:
            if record.ph_sol and (record.ph_sol < 0 or record.ph_sol > 14):
                raise ValidationError("Le pH doit être compris entre 0 et 14.") 