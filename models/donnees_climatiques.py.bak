from odoo import models, fields, api
from odoo.exceptions import ValidationError

class DonneesClimatiques(models.Model):
    _name = 'donnees.climatiques'
    _description = 'Données Climatiques'
    _rec_name = 'date_mesure'
    _order = 'date_mesure desc'

    date_mesure = fields.Date(string="Date de mesure", required=True, default=fields.Date.today)
    exploitation_id = fields.Many2one('exploitation.agri', string="Exploitation")
    
    # Données météorologiques
    temperature_min = fields.Float(string="Température minimale (°C)")
    temperature_max = fields.Float(string="Température maximale (°C)")
    temperature_moyenne = fields.Float(string="Température moyenne (°C)")
    
    humidite_min = fields.Float(string="Humidité minimale (%)")
    humidite_max = fields.Float(string="Humidité maximale (%)")
    humidite_moyenne = fields.Float(string="Humidité moyenne (%)")
    
    pression_atmospherique = fields.Float(string="Pression atmosphérique (hPa)")
    vitesse_vent = fields.Float(string="Vitesse du vent (km/h)")
    direction_vent = fields.Selection([
        ('N', 'Nord'),
        ('NE', 'Nord-Est'),
        ('E', 'Est'),
        ('SE', 'Sud-Est'),
        ('S', 'Sud'),
        ('SO', 'Sud-Ouest'),
        ('O', 'Ouest'),
        ('NO', 'Nord-Ouest'),
    ], string="Direction du vent")
    
    # Précipitations
    pluviometrie = fields.Float(string="Pluviométrie (mm)")
    type_precipitation = fields.Selection([
        ('pluie', 'Pluie'),
        ('neige', 'Neige'),
        ('grele', 'Grêle'),
        ('brouillard', 'Brouillard'),
        ('aucune', 'Aucune'),
    ], string="Type de précipitation", default='aucune')
    
    # Rayonnement solaire
    rayonnement_solaire = fields.Float(string="Rayonnement solaire (W/m²)")
    duree_ensoleillement = fields.Float(string="Durée d'ensoleillement (heures)")
    
    # Indices climatiques
    indice_uv = fields.Float(string="Indice UV")
    indice_humidex = fields.Float(string="Indice humidex")
    indice_refroidissement = fields.Float(string="Indice de refroidissement éolien")
    
    # Alertes climatiques
    alerte_secheresse = fields.Boolean(string="Alerte sécheresse")
    alerte_gel = fields.Boolean(string="Alerte gel")
    alerte_canicule = fields.Boolean(string="Alerte canicule")
    alerte_orage = fields.Boolean(string="Alerte orage")
    alerte_inondation = fields.Boolean(string="Alerte inondation")
    
    # Scénarios climatiques (IPCC RCP)
    scenario_rcp = fields.Selection([
        ('rcp26', 'RCP 2.6 (Optimiste)'),
        ('rcp45', 'RCP 4.5 (Modéré)'),
        ('rcp60', 'RCP 6.0 (Pessimiste modéré)'),
        ('rcp85', 'RCP 8.5 (Pessimiste)'),
    ], string="Scénario RCP")
    
    # Projections futures
    temperature_projetee_2050 = fields.Float(string="Température projetée 2050 (°C)")
    temperature_projetee_2100 = fields.Float(string="Température projetée 2100 (°C)")
    pluviometrie_projetee_2050 = fields.Float(string="Pluviométrie projetée 2050 (mm)")
    pluviometrie_projetee_2100 = fields.Float(string="Pluviométrie projetée 2100 (mm)")
    
    # Source des données
    source_donnees = fields.Selection([
        ('station_meteo', 'Station météo locale'),
        ('api_meteo', 'API météo externe'),
        ('satellite', 'Données satellite'),
        ('modele_climatique', 'Modèle climatique'),
        ('manuel', 'Saisie manuelle'),
    ], string="Source des données", default='manuel')
    
    # Notes
    observations = fields.Text(string="Observations")
    
    @api.constrains('temperature_min', 'temperature_max', 'temperature_moyenne')
    def _check_temperatures(self):
        for record in self:
            if record.temperature_min and record.temperature_max:
                if record.temperature_min > record.temperature_max:
                    raise ValidationError("La température minimale ne peut pas être supérieure à la maximale.")
            if record.temperature_moyenne:
                if record.temperature_min and record.temperature_moyenne < record.temperature_min:
                    raise ValidationError("La température moyenne ne peut pas être inférieure à la minimale.")
                if record.temperature_max and record.temperature_moyenne > record.temperature_max:
                    raise ValidationError("La température moyenne ne peut pas être supérieure à la maximale.")
    
    @api.constrains('humidite_min', 'humidite_max', 'humidite_moyenne')
    def _check_humidite(self):
        for record in self:
            if record.humidite_min and record.humidite_max:
                if record.humidite_min > record.humidite_max:
                    raise ValidationError("L'humidité minimale ne peut pas être supérieure à la maximale.")
            if record.humidite_moyenne:
                if record.humidite_min and record.humidite_moyenne < record.humidite_min:
                    raise ValidationError("L'humidité moyenne ne peut pas être inférieure à la minimale.")
                if record.humidite_max and record.humidite_moyenne > record.humidite_max:
                    raise ValidationError("L'humidité moyenne ne peut pas être supérieure à la maximale.")
    
    @api.constrains('pluviometrie')
    def _check_pluviometrie(self):
        for record in self:
            if record.pluviometrie and record.pluviometrie < 0:
                raise ValidationError("La pluviométrie ne peut pas être négative.")
    
    def action_analyser_tendances(self):
        """Analyser les tendances climatiques"""
        for record in self:
            # Simulation d'analyse des tendances
            if record.temperature_moyenne > 25:
                record.alerte_canicule = True
            if record.temperature_moyenne < -5:
                record.alerte_gel = True
            if record.pluviometrie < 1 and record.temperature_moyenne > 20:
                record.alerte_secheresse = True
    
    def action_importer_api_meteo(self):
        """Importer les données depuis une API météo"""
        # Ici on pourrait intégrer une vraie API météo
        pass 