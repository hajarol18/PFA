from odoo import models, fields, api
from odoo.exceptions import ValidationError

class Intervention(models.Model):
    _name = 'intervention.agri'
    _description = 'Intervention Agricole'
    _rec_name = 'nom'
    _order = 'date_intervention desc'

    nom = fields.Char(string="Nom de l'intervention", required=True)
    exploitation_id = fields.Many2one('exploitation.agri', string="Exploitation", required=True)
    parcelle_id = fields.Many2one('parcelle.agri', string="Parcelle")
    culture_id = fields.Many2one('culture.agri', string="Culture")
    
    # Type d'intervention
    type_intervention = fields.Selection([
        ('semis', 'Semis'),
        ('irrigation', 'Irrigation'),
        ('fertilisation', 'Fertilisation'),
        ('traitement_phyto', 'Traitement phytosanitaire'),
        ('recolte', 'Récolte'),
        ('labour', 'Labour'),
        ('desherbage', 'Désherbage'),
        ('taille', 'Taille'),
        ('autre', 'Autre'),
    ], string="Type d'intervention", required=True)
    
    # Planification
    date_intervention = fields.Date(string="Date d'intervention", required=True, default=fields.Date.today)
    duree_estimee = fields.Float(string="Durée estimée (heures)")
    duree_reelle = fields.Float(string="Durée réelle (heures)")
    
    # Ressources utilisées
    quantite_eau = fields.Float(string="Quantité d'eau (m³)")
    quantite_engrais = fields.Float(string="Quantité d'engrais (kg)")
    quantite_phyto = fields.Float(string="Quantité phytosanitaire (L)")
    quantite_semences = fields.Float(string="Quantité semences (kg)")
    
    # Coûts
    cout_main_oeuvre = fields.Float(string="Coût main d'œuvre (€)")
    cout_materiel = fields.Float(string="Coût matériel (€)")
    cout_intrants = fields.Float(string="Coût intrants (€)")
    cout_total = fields.Float(string="Coût total (€)", compute='_compute_cout_total')
    
    # État et suivi
    etat = fields.Selection([
        ('planifie', 'Planifié'),
        ('en_cours', 'En cours'),
        ('termine', 'Terminé'),
        ('annule', 'Annulé'),
    ], string="État", default='planifie')
    
    # Données météo au moment de l'intervention
    temperature = fields.Float(string="Température (°C)")
    humidite = fields.Float(string="Humidité (%)")
    vitesse_vent = fields.Float(string="Vitesse du vent (km/h)")
    conditions_meteo = fields.Selection([
        ('ensoleille', 'Ensoleillé'),
        ('nuageux', 'Nuageux'),
        ('pluvieux', 'Pluvieux'),
        ('orageux', 'Orageux'),
        ('neigeux', 'Neigeux'),
    ], string="Conditions météo")
    
    # Notes et observations
    observations = fields.Text(string="Observations")
    recommandations = fields.Text(string="Recommandations")
    
    # Relations
    responsable_id = fields.Many2one('res.users', string="Responsable", default=lambda self: self.env.user)
    
    @api.depends('cout_main_oeuvre', 'cout_materiel', 'cout_intrants')
    def _compute_cout_total(self):
        for record in self:
            record.cout_total = record.cout_main_oeuvre + record.cout_materiel + record.cout_intrants
    
    @api.constrains('date_intervention', 'duree_estimee', 'duree_reelle')
    def _check_values(self):
        for record in self:
            if record.date_intervention > fields.Date.today():
                raise ValidationError("La date d'intervention ne peut pas être dans le futur.")
            if record.duree_estimee and record.duree_estimee < 0:
                raise ValidationError("La durée estimée ne peut pas être négative.")
            if record.duree_reelle and record.duree_reelle < 0:
                raise ValidationError("La durée réelle ne peut pas être négative.")
    
    @api.onchange('parcelle_id')
    def _onchange_parcelle(self):
        if self.parcelle_id and not self.exploitation_id:
            self.exploitation_id = self.parcelle_id.exploitation_id
    
    @api.onchange('culture_id')
    def _onchange_culture(self):
        if self.culture_id:
            self.parcelle_id = self.culture_id.parcelle_id
            self.exploitation_id = self.culture_id.exploitation_id
    
    def action_demarrer(self):
        """Démarrer l'intervention"""
        for record in self:
            record.etat = 'en_cours'
    
    def action_terminer(self):
        """Terminer l'intervention"""
        for record in self:
            record.etat = 'termine'
    
    def action_annuler(self):
        """Annuler l'intervention"""
        for record in self:
            record.etat = 'annule' 