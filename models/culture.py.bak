from odoo import models, fields, api
from odoo.exceptions import ValidationError
from datetime import datetime, timedelta

class Culture(models.Model):
    _name = 'culture.agri'
    _description = 'Culture Agricole'
    _rec_name = 'nom'
    _order = 'date_semis desc'

    nom = fields.Char(string="Nom de la culture", required=True)
    exploitation_id = fields.Many2one('exploitation.agri', string="Exploitation", required=True)
    parcelle_id = fields.Many2one('parcelle.agri', string="Parcelle", required=True)
    
    # Données de base
    variete = fields.Char(string="Variété")
    superficie_cultivee = fields.Float(string="Superficie cultivée (ha)", required=True)
    
    # Cycle cultural
    date_semis = fields.Date(string="Date de semis")
    date_recolte = fields.Date(string="Date de récolte")
    duree_cycle = fields.Integer(string="Durée du cycle (jours)", compute='_compute_duree_cycle')
    
    # Données de rendement
    rendement = fields.Float(string="Rendement (t/ha)")
    production_totale = fields.Float(string="Production totale (t)", compute='_compute_production')
    
    # Données climatiques
    temperature_moyenne = fields.Float(string="Température moyenne (°C)")
    pluviometrie_totale = fields.Float(string="Pluviométrie totale (mm)")
    humidite_relative = fields.Float(string="Humidité relative (%)")
    
    # Données d'intrants
    quantite_semences = fields.Float(string="Quantité semences (kg/ha)")
    quantite_engrais = fields.Float(string="Quantité engrais (kg/ha)")
    quantite_eau_irrigation = fields.Float(string="Quantité eau irrigation (m³/ha)")
    
    # Coûts
    cout_semences = fields.Float(string="Coût semences (€/ha)")
    cout_engrais = fields.Float(string="Coût engrais (€/ha)")
    cout_irrigation = fields.Float(string="Coût irrigation (€/ha)")
    cout_main_oeuvre = fields.Float(string="Coût main d'œuvre (€/ha)")
    cout_total = fields.Float(string="Coût total (€/ha)", compute='_compute_cout_total')
    
    # État de la culture
    etat_culture = fields.Selection([
        ('semis', 'Semis'),
        ('levée', 'Levée'),
        ('croissance', 'Croissance'),
        ('floraison', 'Floraison'),
        ('maturation', 'Maturation'),
        ('recolte', 'Récolte'),
        ('termine', 'Terminé'),
    ], string="État de la culture", default='semis')
    
    # Risques et alertes
    risque_secheresse = fields.Boolean(string="Risque sécheresse")
    risque_maladie = fields.Boolean(string="Risque maladie")
    risque_gel = fields.Boolean(string="Risque gel")
    
    # Recommandations IA
    recommandation_ia = fields.Text(string="Recommandation IA")
    score_optimisation = fields.Float(string="Score d'optimisation", help="Score de 0 à 100")
    
    # Relations
    interventions_ids = fields.One2many('intervention.agri', 'culture_id', string="Interventions")
    
    @api.depends('date_semis', 'date_recolte')
    def _compute_duree_cycle(self):
        for record in self:
            if record.date_semis and record.date_recolte:
                delta = record.date_recolte - record.date_semis
                record.duree_cycle = delta.days
            else:
                record.duree_cycle = 0
    
    @api.depends('rendement', 'superficie_cultivee')
    def _compute_production(self):
        for record in self:
            record.production_totale = record.rendement * record.superficie_cultivee
    
    @api.depends('cout_semences', 'cout_engrais', 'cout_irrigation', 'cout_main_oeuvre')
    def _compute_cout_total(self):
        for record in self:
            record.cout_total = (record.cout_semences + record.cout_engrais + 
                               record.cout_irrigation + record.cout_main_oeuvre)
    
    @api.constrains('superficie_cultivee', 'rendement')
    def _check_values(self):
        for record in self:
            if record.superficie_cultivee <= 0:
                raise ValidationError("La superficie cultivée doit être strictement positive.")
            if record.rendement and record.rendement < 0:
                raise ValidationError("Le rendement ne peut pas être négatif.")
    
    @api.constrains('date_semis', 'date_recolte')
    def _check_dates(self):
        for record in self:
            if record.date_semis and record.date_recolte:
                if record.date_semis >= record.date_recolte:
                    raise ValidationError("La date de semis doit être antérieure à la date de récolte.")
    
    @api.onchange('parcelle_id')
    def _onchange_parcelle(self):
        if self.parcelle_id:
            self.superficie_cultivee = min(self.parcelle_id.superficie, self.superficie_cultivee or 0)
    
    def action_analyser_risques(self):
        """Action pour analyser les risques climatiques"""
        for record in self:
            # Simulation d'analyse des risques
            if record.temperature_moyenne > 30:
                record.risque_secheresse = True
            if record.humidite_relative > 80:
                record.risque_maladie = True
            if record.temperature_moyenne < 0:
                record.risque_gel = True
