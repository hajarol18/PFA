from odoo import models, fields, api
from odoo.exceptions import ValidationError

class IntrantsRessources(models.Model):
    _name = 'intrants.ressources'
    _description = 'Intrants et Ressources'
    _rec_name = 'nom'
    _order = 'date_utilisation desc'

    nom = fields.Char(string="Nom de l'intrant/ressource", required=True)
    exploitation_id = fields.Many2one('exploitation.agri', string="Exploitation", required=True)
    parcelle_id = fields.Many2one('parcelle.agri', string="Parcelle")
    culture_id = fields.Many2one('culture.agri', string="Culture")
    
    # Type de ressource
    type_ressource = fields.Selection([
        ('eau', 'Eau'),
        ('engrais', 'Engrais'),
        ('semences', 'Semences'),
        ('phyto', 'Produits phytosanitaires'),
        ('main_oeuvre', 'Main d\'œuvre'),
        ('materiel', 'Matériel'),
        ('energie', 'Énergie'),
        ('autre', 'Autre'),
    ], string="Type de ressource", required=True)
    
    # Données d'utilisation
    date_utilisation = fields.Date(string="Date d'utilisation", required=True, default=fields.Date.today)
    quantite_utilisee = fields.Float(string="Quantité utilisée", required=True)
    unite_mesure = fields.Selection([
        ('m3', 'm³'),
        ('kg', 'kg'),
        ('l', 'L'),
        ('h', 'heures'),
        ('kwh', 'kWh'),
        ('ha', 'ha'),
        ('autre', 'Autre'),
    ], string="Unité de mesure", required=True)
    
    # Coûts
    cout_unitaire = fields.Float(string="Coût unitaire (€)")
    cout_total = fields.Float(string="Coût total (€)", compute='_compute_cout_total')
    
    # Efficacité
    efficacite = fields.Float(string="Efficacité (%)", help="Efficacité de l'utilisation de la ressource")
    rendement_impact = fields.Float(string="Impact sur le rendement (t/ha)")
    
    # Données environnementales
    impact_environnemental = fields.Selection([
        ('faible', 'Faible'),
        ('modere', 'Modéré'),
        ('eleve', 'Élevé'),
    ], string="Impact environnemental", default='modere')
    
    # Source de la ressource
    source_ressource = fields.Selection([
        ('propre', 'Production propre'),
        ('achat', 'Achat'),
        ('location', 'Location'),
        ('partage', 'Partage/Coopération'),
    ], string="Source de la ressource", default='achat')
    
    # Fournisseur
    fournisseur = fields.Char(string="Fournisseur")
    
    # Notes
    observations = fields.Text(string="Observations")
    
    @api.depends('quantite_utilisee', 'cout_unitaire')
    def _compute_cout_total(self):
        for record in self:
            record.cout_total = record.quantite_utilisee * record.cout_unitaire
    
    @api.constrains('quantite_utilisee', 'efficacite')
    def _check_values(self):
        for record in self:
            if record.quantite_utilisee <= 0:
                raise ValidationError("La quantité utilisée doit être strictement positive.")
            if record.efficacite and (record.efficacite < 0 or record.efficacite > 100):
                raise ValidationError("L'efficacité doit être comprise entre 0 et 100%.")
    
    @api.onchange('parcelle_id')
    def _onchange_parcelle(self):
        if self.parcelle_id and not self.exploitation_id:
            self.exploitation_id = self.parcelle_id.exploitation_id
    
    @api.onchange('culture_id')
    def _onchange_culture(self):
        if self.culture_id:
            self.parcelle_id = self.culture_id.parcelle_id
            self.exploitation_id = self.culture_id.exploitation_id

class StockIntrants(models.Model):
    _name = 'stock.intrants'
    _description = 'Stock d\'Intrants'
    _rec_name = 'nom'

    nom = fields.Char(string="Nom de l'intrant", required=True)
    exploitation_id = fields.Many2one('exploitation.agri', string="Exploitation", required=True)
    
    # Type d'intrant
    type_intrant = fields.Selection([
        ('engrais', 'Engrais'),
        ('semences', 'Semences'),
        ('phyto', 'Produits phytosanitaires'),
        ('autre', 'Autre'),
    ], string="Type d'intrant", required=True)
    
    # Stock
    quantite_stock = fields.Float(string="Quantité en stock", required=True)
    quantite_min = fields.Float(string="Quantité minimale", help="Seuil d'alerte")
    unite_mesure = fields.Selection([
        ('kg', 'kg'),
        ('l', 'L'),
        ('unite', 'Unité'),
    ], string="Unité de mesure", required=True)
    
    # Coûts
    cout_unitaire = fields.Float(string="Coût unitaire (€)")
    valeur_stock = fields.Float(string="Valeur du stock (€)", compute='_compute_valeur_stock')
    
    # Fournisseur
    fournisseur = fields.Char(string="Fournisseur")
    date_dernier_achat = fields.Date(string="Date du dernier achat")
    
    # État du stock
    etat_stock = fields.Selection([
        ('normal', 'Normal'),
        ('faible', 'Faible'),
        ('rupture', 'Rupture'),
    ], string="État du stock", compute='_compute_etat_stock')
    
    @api.depends('quantite_stock', 'cout_unitaire')
    def _compute_valeur_stock(self):
        for record in self:
            record.valeur_stock = record.quantite_stock * record.cout_unitaire
    
    @api.depends('quantite_stock', 'quantite_min')
    def _compute_etat_stock(self):
        for record in self:
            if record.quantite_stock <= 0:
                record.etat_stock = 'rupture'
            elif record.quantite_stock <= record.quantite_min:
                record.etat_stock = 'faible'
            else:
                record.etat_stock = 'normal' 